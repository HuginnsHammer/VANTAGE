VANTAGE_ENV=development
VANTAGE_DATABASE_URL=postgresql+psycopg://vantage_app:CHANGE_ME@localhost:5432/vantage
VANTAGE_MIGRATION_DATABASE_URL=postgresql+psycopg://vantage_migrator:CHANGE_ME@localhost:5432/vantage
VANTAGE_OIDC_ISSUER=https://YOUR_IDENTITY_PROVIDER/
VANTAGE_OIDC_AUTHORIZATION_URL=https://YOUR_IDENTITY_PROVIDER/authorize
VANTAGE_OIDC_TOKEN_URL=https://YOUR_IDENTITY_PROVIDER/oauth/token
VANTAGE_OIDC_AUDIENCE=https://api.vantage.example
VANTAGE_OIDC_CLIENT_ID=YOUR_PUBLIC_SPA_CLIENT_ID
VANTAGE_OIDC_REDIRECT_URI=https://app.vantage.example/app
VANTAGE_PUBLIC_BASE_URL=https://app.vantage.example
VANTAGE_OIDC_SCOPE=openid profile email
VANTAGE_OIDC_JWKS_URL=https://YOUR_IDENTITY_PROVIDER/.well-known/jwks.json
VANTAGE_CORS_ORIGINS=https://app.vantage.example
VANTAGE_REDIS_URL=redis://localhost:6379/0
VANTAGE_LOG_LEVEL=INFO
